- name: Timestamps - event_time in milliseconds converted, stale timestamp replaced by now
  code: |-
    mock('getAllEventData', () => ({event_name: 'page_view', event_id: 'e', page_location: 'https://shop.example.com/x', 'x-ga-gcs': 'G111', event_time: NOW - 60000}));
