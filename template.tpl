  Request
==============================================================================*/

const payload = {
  data: [event]
};

sendHttpRequest(CAPI_ENDPOINT, (statusCode, headers, body) => {
  const response = body ? JSON.parse(body) : undefined;
  const failedEvent = response && getType(response.events) === 'array' && response.events[0] && response.events[0].status === 'failed';
  if (statusCode >= 200 && statusCode < 300 && !failedEvent) {
    const clickId = event.user_data.click_id;
    if (consentGranted && data.generateCookies && clickId && keepChars(clickId, COOKIE_SAFE_CHARS).length === clickId.length) {
      setCookie(CLICK_ID_COOKIE, clickId, {
        domain: originDomain ? '.' + originDomain : 'auto',
        path: '/',
        samesite: 'Lax',
        secure: true,
        'max-age': CLICK_ID_COOKIE_MAX_AGE,
        httpOnly: false
      }, true);
    }
    data.gtmOnSuccess();
  } else {
    data.gtmOnFailure();
  }
}, {
  headers: {
    'content-type': 'application/json',
    'authorization': 'Bearer ' + makeString(data.accessToken).trim()
  },
  method: 'POST'
}, JSON.stringify(payload));


