==============================================================================*/

if (data.serverEvent) {
  data.serverEvent.forEach(o => {
    if (o.name === 'event_time') {
      event.event_time = makeInteger(o.value);
    } else if (o.name === 'opt_out') {
      event.opt_out = o.value === true || o.value === 'true';
    } else if (o.name === 'action_source') {
      event.action_source = ACTION_SOURCE_ALIASES[o.value] || o.value;
    } else {
      event[o.name] = o.value;
    }
  });
}

const USER_FIELD_ALIASES = {
  'email': 'em',
  'phone': 'ph',
  'phone_number': 'ph',
  'first_name': 'fn',
  'last_name': 'ln',
  'gender': 'ge',
  'date_of_birth': 'db',
  'city': 'ct',
  'state': 'st',
  'region': 'st',
  'zip_code': 'zp',
  'postal_code': 'zp',
  'epik': 'click_id',
  'ip_address': 'client_ip_address',
  'user_agent': 'client_user_agent'
};
const USER_LIST_TRANSFORMS = {
  'em': hashEmail,
  'ph': hashPhone,
  'fn': hashLowercase,
  'ln': hashLowercase,
  'ge': hashGender,
  'db': hashDateOfBirth,
  'ct': hashCity,
  'st': hashLowercase,
  'zp': hashZip,
  'country': hashCountry,
  'external_id': hashExternalId
};

if (data.userData) {
  data.userData.forEach(o => {
    const name = USER_FIELD_ALIASES[o.name] || o.name;
    // Without consent, only the IP address and user agent can be set manually.
    if (!consentGranted && name !== 'client_ip_address' && name !== 'client_user_agent') {
      return;
    }
    if (USER_LIST_TRANSFORMS[name]) {
      const list = toApiList(toList(o.value), USER_LIST_TRANSFORMS[name]);
      if (list.length > 0) {
        event.user_data[name] = list;
      } else {
        event.user_data[name] = undefined;
      }
    } else {
      event.user_data[name] = o.value;
    }
  });
}

if (data.customData) {
  data.customData.forEach(o => {
    if (o.name === 'value' || o.name === 'predicted_ltv') {
      const amount = toNumber(o.value);
      event.custom_data[o.name] = amount !== undefined ? formatAmount(amount) : undefined;
    } else if (o.name === 'num_items') {
      event.custom_data.num_items = makeInteger(o.value);
    } else if (o.name === 'currency') {
      event.custom_data.currency = makeString(o.value).toUpperCase();
    } else if (o.name === 'content_ids') {
      const ids = getType(o.value) === 'string' && o.value.indexOf('[') !== 0 ? o.value.split(',') : toList(o.value);
      event.custom_data.content_ids = ids.map(id => makeString(id).trim());
    } else if (o.name === 'contents' && getType(o.value) === 'string') {
      event.custom_data.contents = JSON.parse(o.value);
    } else {
      event.custom_data[o.name] = o.value;
    }
  });
}

event.user_data = cleanObject(event.user_data);
event.custom_data = cleanObject(event.custom_data);
event = cleanObject(event);

