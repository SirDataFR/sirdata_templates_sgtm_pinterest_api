/*==============================================================================
  Generic helpers
==============================================================================*/

function includes(arr, element) {
  for (let i = 0; i < arr.length; i++) {
    if (arr[i] === element) { return true; }
  }
  return false;
}

function isValidValue(value) {
  const valueType = getType(value);
  return valueType !== 'null' && valueType !== 'undefined' && value !== '' && value !== 'undefined' && value !== 'null' && value !== 'redacted_for_privacy' && value === value;
}

function isSHA256Hashed(value) {
  if (!isValidValue(value)) { return false; }
  return makeString(value).match('^[A-Fa-f0-9]{64}$') !== null;
}

function hashValue(value) {
  return sha256Sync(value, {outputEncoding: 'hex'});
}

function stripChars(value, charsToRemove) {
  let result = '';
  for (let i = 0; i < value.length; i++) {
    if (charsToRemove.indexOf(value[i]) === -1) {
      result += value[i];
    }
  }
  return result;
}

function keepChars(value, charsToKeep) {
  let result = '';
  for (let i = 0; i < value.length; i++) {
    if (charsToKeep.indexOf(value[i]) !== -1) {
      result += value[i];
    }
  }
  return result;
}

const DIGITS = '0123456789';
const WHITESPACE_AND_ASCII_PUNCTUATION = ' \t\n\r!"#$%&\'()*+,-./:;<=>?@[\\]^_`{|}~';

// Email: trim + lowercase. Pre-hashed values are accepted as-is.
function hashEmail(value) {
  if (!isValidValue(value)) { return; }
  if (isSHA256Hashed(value)) { return makeString(value).toLowerCase(); }
  const email = makeString(value).trim().toLowerCase();
  if (email.indexOf('@') < 1 || email.indexOf('.', email.indexOf('@')) === -1) { return; }
  return hashValue(email);
}

// Phone: digits only (country code kept), no leading "+" and no leading zeroes, 8-15 digits.
function hashPhone(value) {
  if (!isValidValue(value)) { return; }
  if (isSHA256Hashed(value)) { return makeString(value).toLowerCase(); }
  let digits = keepChars(makeString(value), DIGITS);
  while (digits.length > 0 && digits[0] === '0') {
    digits = digits.slice(1);
  }
  if (digits.length < 8 || digits.length > 15) { return; }
  return hashValue(digits);
}

// First/last name, state: trim + lowercase.
function hashLowercase(value) {
  if (!isValidValue(value)) { return; }
  if (isSHA256Hashed(value)) { return makeString(value).toLowerCase(); }
  const normalized = makeString(value).trim().toLowerCase();
  if (!normalized) { return; }
  return hashValue(normalized);
}

// City: lowercase, without spaces or punctuation.
function hashCity(value) {
  if (!isValidValue(value)) { return; }
  if (isSHA256Hashed(value)) { return makeString(value).toLowerCase(); }
  const city = stripChars(makeString(value).toLowerCase(), WHITESPACE_AND_ASCII_PUNCTUATION);
  if (!city) { return; }
  return hashValue(city);
}

// Zip code: lowercase, without spaces or dashes (5-digit ZIP for US ZIP+4 codes).
function hashZip(value) {
  if (!isValidValue(value)) { return; }
  if (isSHA256Hashed(value)) { return makeString(value).toLowerCase(); }
  let zip = stripChars(makeString(value).toLowerCase(), ' \t\n\r');
  if (zip.length === 10 && zip[5] === '-' && keepChars(zip, DIGITS).length === 9) {
    zip = zip.slice(0, 5);
  }
  zip = stripChars(zip, '-');
  if (!zip) { return; }
  return hashValue(zip);
}

// Country: 2-letter ISO 3166-1 code, lowercase.
function hashCountry(value) {
  if (!isValidValue(value)) { return; }
  if (isSHA256Hashed(value)) { return makeString(value).toLowerCase(); }
  const country = makeString(value).trim().toLowerCase();
  if (country.length !== 2) { return; }
  return hashValue(country);
}

// Gender: "f", "m" or "n".
function hashGender(value) {
  if (!isValidValue(value)) { return; }
  if (isSHA256Hashed(value)) { return makeString(value).toLowerCase(); }
  const gender = makeString(value).trim().toLowerCase();
  if (includes(['f', 'female', 'woman'], gender)) { return hashValue('f'); }
  if (includes(['m', 'male', 'man'], gender)) { return hashValue('m'); }
  if (includes(['n', 'non-binary', 'nonbinary'], gender)) { return hashValue('n'); }
}

// Date of birth: YYYYMMDD.
function hashDateOfBirth(value) {
  if (!isValidValue(value)) { return; }
  if (isSHA256Hashed(value)) { return makeString(value).toLowerCase(); }
  const digits = keepChars(makeString(value), DIGITS);
  if (digits.length !== 8) { return; }
  return hashValue(digits);
}

// External ID: trim + lowercase, as hashed by the Pinterest tag.
function hashExternalId(value) {
  return hashLowercase(value);
}

function isValidUUID(uuid) {
  if (!uuid || uuid.length !== 36 || uuid[8] !== '-' || uuid[13] !== '-' || uuid[18] !== '-' || uuid[23] !== '-') {
    return false;
  }
  const hexChars = '0123456789abcdefABCDEF';
  for (let i = 0; i < uuid.length; i++) {
    if (i !== 8 && i !== 13 && i !== 18 && i !== 23 && hexChars.indexOf(uuid[i]) === -1) {
      return false;
    }
  }
  return true;
}

function getValidUUID(uuid) {
  if (!uuid || !isValidUUID(uuid)) { return; }
  return uuid;
}

function toList(value) {
  const type = getType(value);
  let values = [];
  if (type === 'array') {
    values = value;
  } else if (type === 'string' && value.indexOf('[') === 0) {
    const parsed = JSON.parse(value);
    values = getType(parsed) === 'array' ? parsed : [value];
  } else {
    values = [value];
  }
  return values;
}

// Keeps the first 3 valid unique values.
function toApiList(values, transform) {
  const result = [];
  for (let i = 0; i < values.length; i++) {
    const transformed = transform(values[i]);
    if (isValidValue(transformed) && !includes(result, transformed)) {
      result.push(transformed);
    }
    if (result.length === 3) { break; }
  }
  return result;
}

function deepEqual(a, b) {
  if (a === b) return true;
  if (typeof a !== 'object' || a === null || typeof b !== 'object' || b === null) {
    return false;
  }
  const keysA = Object.keys(a);
  const keysB = Object.keys(b);
  if (keysA.length !== keysB.length) return false;
  for (let i = 0; i < keysA.length; i++) {
    if (!includes(keysB, keysA[i])) return false;
    if (!deepEqual(a[keysA[i]], b[keysA[i]])) return false;
  }
  return true;
}

function deepMerge(a, b) {
  let result = {};
  for (let key in a) {
    if (a.hasOwnProperty(key)) {
      result[key] = a[key];
    }
  }
  for (let key in b) {
    if (b.hasOwnProperty(key)) {
      if (typeof b[key] === 'object' && b[key] !== null && typeof result[key] === 'object' && result[key] !== null) {
        result[key] = deepMerge(result[key], b[key]);
      } else {
        result[key] = b[key];
      }
    }
  }
  return result;
}

function cleanObject(obj) {
  const cleaned = {};
  const keys = Object.keys(obj);
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i];
    const value = obj[key];
    const type = getType(value);
    if (type === 'array') {
      if (value.length > 0) { cleaned[key] = value; }
    } else if (type === 'boolean' || type === 'object' || isValidValue(value)) {
      cleaned[key] = value;
    }
  }
  return cleaned;
}

function toNumber(value) {
  if (!isValidValue(value)) { return; }
  const number = makeNumber(value);
  return number === number ? number : undefined;
}

// Amount as a string with 2 decimals at most (42.5 -> "42.5").
function formatAmount(value) {
  return makeString(Math.round(value * 100) / 100);
}

/*==============================================================================
  Event metadata
==============================================================================*/

const referrer = eventData.page_referrer;
const originDomain = getValueFromHeader('gtm-helper-site-domain') || (location ? computeEffectiveTldPlusOne(location) : undefined);
const userIp = getValueFromHeader('gtm-helper-user-ip') || eventData.ip_override;

function getEventName(eventName) {
  if (data.eventName === 'custom') {
    return data.customEventName;
  }
  if (!data.eventName || data.eventName === 'inherit') {
    return GA4_MAPPINGS[eventName] || eventName;
  }
  return data.eventName;
}

function getActionSource() {
  let source = eventData.action_source ? makeString(eventData.action_source).toLowerCase() : 'web';
  source = ACTION_SOURCE_ALIASES[source] || source;
  return includes(ACTION_SOURCES, source) ? source : 'web';
}

function getEventTime() {
  let ts;
  if (isValidValue(eventData.event_time)) {
    ts = makeNumber(eventData.event_time);
    ts = ts < 100000000000 ? makeInteger(ts * 1000) : makeInteger(ts);
  }
  // API constraint: events older than 7 days are rejected.
  if (!ts || ts !== ts || ts > tsMilli + 600000 || ts < tsMilli - 7 * 24 * 60 * 60 * 1000) {
    ts = tsMilli;
  }
  return Math.floor(ts / 1000);
}

function getLanguage() {
  if (!isValidValue(eventData.language)) { return; }
  const language = makeString(eventData.language).trim().toLowerCase().slice(0, 2);
  return language.length === 2 ? language : undefined;
}

function getClickIdFromUrl(url) {
  if (!url) { return; }
  const parsed = parseUrl(url);
  if (parsed && parsed.searchParams && parsed.searchParams.epik) {
    return decodeUriComponent(parsed.searchParams.epik);
  }
}

function getClickId() {
  let clickId = getClickIdFromUrl(location) || getClickIdFromUrl(referrer);
  if (!clickId && consentGranted) {
    clickId = getCookieValues(CLICK_ID_COOKIE)[0];
  }
  if (!clickId) {
    clickId = (eventData.common_cookie || {})[CLICK_ID_COOKIE] || eventData.click_id || eventData.epik;
  }
  return isValidValue(clickId) ? makeString(clickId) : undefined;
}

let event = {user_data: {}, custom_data: {}};
event.event_name = getEventName(eventData.event_name);
event.event_id = makeString(eventData.event_id || eventData.transaction_id || ('sirdata-sgtm-' + tsMilli + '-' + generateRandom(100000, 999999)));
event.event_time = getEventTime();
event.action_source = getActionSource();
event.event_source_url = location;
event.opt_out = !consentGranted || eventData.opt_out === true;
event.partner_name = PARTNER_NAME;
event.language = getLanguage();
event.user_data.click_id = getClickId();

/*==============================================================================
  User data: GA4 user_data + Sirdata gtm-helper headers + _gtmeec enrichment
  profile keys follow the _gtmeec convention shared with the Meta CAPI tag:
  em/ph/fn/ln already hashed, external_id/ct/st/zp/country raw.
==============================================================================*/

let profile = {};

if (consentGranted && data.forwardUserData) {
  const userData = eventData.user_data || {};
  profile.em = hashEmail(userData.email) || hashEmail(userData.email_address) || hashEmail(eventData.email) || hashEmail(userData.sha256_email_address) || hashEmail(getValueFromHeader('gtm-helper-user-hashed-email'));
  profile.ph = hashPhone(userData.phone_number) || hashPhone(eventData.phone_number) || hashPhone(userData.sha256_phone_number) || hashPhone(getValueFromHeader('gtm-helper-user-hashed-phone'));
  profile.ge = hashGender(userData.gender);
  profile.db = hashDateOfBirth(userData.date_of_birth);
  if (userData['address[0]'] && (!userData.address || !userData.address[0])) {
    userData.address = userData.address || {};
    userData.address[0] = userData['address[0]'];
  }
  let address = userData.address;
  if (getType(address) === 'array') {
    address = address[0];
  }
  if (address && getType(address) === 'object') {
    profile.fn = hashLowercase(address.sha256_first_name) || hashLowercase(address.first_name);
    profile.ln = hashLowercase(address.sha256_last_name) || hashLowercase(address.last_name);
    profile.ct = address.city;
    profile.st = address.region;
    profile.zp = address.postal_code;
    profile.country = address.country;
  }
}

if (data.forwardIdentifiers) {
  // Without consent, only Sirdata's site-only cookieless ID is used as external ID.
  profile.external_id = (consentGranted ? (eventData.external_id || eventData.user_id) : undefined) || getValidUUID(getValueFromHeader('gtm-helper-cookieless-id-domain-specific'));
  event.user_data.client_ip_address = userIp;
  // Pinterest requires the IP address and user agent pair when no email is sent:
  // the stored user agent is only used when consent is given.
  event.user_data.client_user_agent = (consentGranted ? getValueFromHeader('gtm-helper-device-user-agent') : undefined) || eventData.user_agent || getValueFromHeader('user-agent');
  if (!isValidValue(profile.country)) {
    profile.country = getValueFromHeader('gtm-helper-user-country');
  }
  if (!isValidValue(profile.ct)) {
    profile.ct = getValueFromHeader('gtm-helper-user-city');
  }
}

// Read/write the _gtmeec cookie shared with the Sirdata Meta CAPI tag (only the keys hashed identically).
function enhanceProfile(profile) {
  if (!consentGranted || !data.generateCookies || !data.forwardUserData) {
    return profile;
  }
  let storedValues = {};
  const cookieValues = getCookieValues(ENRICHMENT_COOKIE);
  if (cookieValues && cookieValues.length > 0) {
    const decoded = fromBase64(cookieValues[0]);
    if (decoded) {
      const parsed = JSON.parse(decoded);
      if (parsed && getType(parsed) === 'object') {
        storedValues = parsed;
      }
    }
  }
  const keysToEnhance = ['em', 'ph', 'external_id'];
  let enhanced = {};
  for (let i = 0; i < keysToEnhance.length; i++) {
    const key = keysToEnhance[i];
    let value = profile[key];
    if (key === 'external_id' && !data.forwardIdentifiers) { continue; }
    if (!isValidValue(value) && isValidValue(storedValues[key])) {
      if (key === 'external_id' || isSHA256Hashed(storedValues[key])) {
        value = storedValues[key];
      }
    }
    if (isValidValue(value)) {
      enhanced[key] = value;
    }
  }
  const toRecord = deepMerge(storedValues, enhanced);
  if (Object.keys(enhanced).length > 0 && !deepEqual(storedValues, toRecord)) {
    setCookie(ENRICHMENT_COOKIE, toBase64(JSON.stringify(toRecord)), {
      domain: getValueFromHeader('gtm-helper-server-host') || (originDomain ? '.' + originDomain : 'auto'),
      path: '/',
      samesite: 'Lax',
      secure: true,
      'max-age': ENRICHMENT_COOKIE_MAX_AGE,
      httpOnly: true
    });
  }
  return deepMerge(profile, enhanced);
}

profile = enhanceProfile(profile);

if (profile.em) { event.user_data.em = [profile.em]; }
if (profile.ph) { event.user_data.ph = [profile.ph]; }
if (profile.fn) { event.user_data.fn = [profile.fn]; }
if (profile.ln) { event.user_data.ln = [profile.ln]; }
if (profile.ge) { event.user_data.ge = [profile.ge]; }
if (profile.db) { event.user_data.db = [profile.db]; }
const hashedCity = hashCity(profile.ct);
const hashedState = hashLowercase(profile.st);
const hashedZip = hashZip(profile.zp);
const hashedCountry = hashCountry(profile.country);
const hashedExternalId = hashExternalId(profile.external_id);
if (hashedCity) { event.user_data.ct = [hashedCity]; }
if (hashedState) { event.user_data.st = [hashedState]; }
if (hashedZip) { event.user_data.zp = [hashedZip]; }
if (hashedCountry) { event.user_data.country = [hashedCountry]; }
if (hashedExternalId) { event.user_data.external_id = [hashedExternalId]; }

/*==============================================================================
  Custom data (value, currency, contents)
==============================================================================*/

let eventCurrency = eventData.currency;
let eventValue = toNumber(eventData.value);
const itemIdKey = data.itemIdKey || 'item_id';

let items;
if (getType(eventData.items) === 'array' && eventData.items.length > 0) {
  items = eventData.items;
} else if (eventData.ecommerce && getType(eventData.ecommerce.items) === 'array' && eventData.ecommerce.items.length > 0) {
  items = eventData.ecommerce.items;
}

if (items) {
  if (!eventCurrency && items[0] && items[0].currency) {
    eventCurrency = items[0].currency;
  }
  let contents = [];
  let contentIds = [];
  let numItems = 0;
  let valueFromItems = 0;
  for (let i = 0; i < items.length; i++) {
    const item = items[i];
    if (!item || getType(item) !== 'object') { continue; }
    let content = {};
    if (isValidValue(item[itemIdKey])) {
      content.id = makeString(item[itemIdKey]);
      if (!includes(contentIds, content.id)) { contentIds.push(content.id); }
    }
    if (isValidValue(item.item_name)) { content.item_name = makeString(item.item_name); }
    const quantity = isValidValue(item.quantity) ? makeInteger(item.quantity) : 1;
    content.quantity = quantity > 0 ? quantity : 1;
    const price = toNumber(item.price);
    if (price !== undefined) {
      content.item_price = formatAmount(price);
      valueFromItems += price * content.quantity;
    }
    if (isValidValue(item.item_category)) { content.item_category = makeString(item.item_category); }
    if (isValidValue(item.item_brand)) { content.item_brand = makeString(item.item_brand); }
    contents.push(cleanObject(content));
    numItems += content.quantity;
  }
  if (contents.length > 0) {
    event.custom_data.contents = contents;
    event.custom_data.num_items = numItems;
  }
  if (contentIds.length > 0) {
    event.custom_data.content_ids = contentIds;
  }
  if (contents.length === 1) {
    event.custom_data.content_name = contents[0].item_name;
    event.custom_data.content_brand = contents[0].item_brand;
  }
  if (contents.length > 0) {
    event.custom_data.content_category = contents[0].item_category;
  }
  if ((eventValue === undefined || eventValue === 0) && valueFromItems > 0) {
    eventValue = valueFromItems;
  }
}

if (eventValue !== undefined) {
  event.custom_data.value = formatAmount(eventValue);
}
if (isValidValue(eventCurrency)) {
  event.custom_data.currency = makeString(eventCurrency).toUpperCase();
}
if (isValidValue(eventData.transaction_id)) {
  event.custom_data.order_id = makeString(eventData.transaction_id);
}
if (isValidValue(eventData.search_term)) {
  event.custom_data.search_string = makeString(eventData.search_term);
}
if (isValidValue(eventData.item_list_name)) {
  event.custom_data.content_category = makeString(eventData.item_list_name);
}

