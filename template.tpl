/*==============================================================================
  Consent gate (Sirdata gtm-helper headers > Consent Mode gcs > GDPR does not apply)
==============================================================================*/

const eventData = getAllEventData();

function getValueFromHeader(headerName) {
  if (!headerName) { return; }
  const valueFromHeader = getRequestHeader(headerName);
  if (!valueFromHeader || valueFromHeader == 'undefined') { return; }
  return valueFromHeader;
}

const gcsParam = getRequestQueryParameter('gcs') || eventData['x-ga-gcs'];
const consentGranted = (getValueFromHeader('gtm-helper-consent-personalized-ads') == 'true' || (gcsParam && gcsParam[2] == '1') || (getValueFromHeader('gtm-helper-gdpr-applies') == 'false' && !gcsParam)) ? true : false;
if (!data.adAccountId || !data.accessToken || (!data.sendWithoutConsent && !consentGranted)) {
  data.gtmOnSuccess();
  return;
}

const location = eventData.page_location || getRequestHeader('referer') || getValueFromHeader('gtm-helper-site-origin');
if (location && location.lastIndexOf('https://gtm-msr.appspot.com/', 0) === 0) {
  data.gtmOnSuccess();
  return;
}

